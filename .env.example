# Frontend public key only. Never put secret keys in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only values: set these as Supabase Edge Function secrets
# (supabase secrets set KEY=value), never in this .env file.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
SUPABASE_ANON_KEY=
SITE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
